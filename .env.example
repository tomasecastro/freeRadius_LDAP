# Copia este archivo a .env antes de ejecutar Docker Compose.
# Reemplaza cada valor CHANGE_ME por secretos propios del despliegue.
# No hay passwords reales en este ejemplo.

# === Conexion MySQL (sobreescribible) ===
MYSQL_HOST=radius-mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: puerto del host para MariaDB (por defecto 3306, igual que el interno).
# Cambiar (p. ej. 3307) para evitar conflictos con un MariaDB local.
# Las conexiones internas entre servicios usan siempre MYSQL_PORT (3306).
MYSQL_HOST_PORT=3306 # (sin efecto: radius-mysql no publica puertos; reservado)
# ./var/backup/ se crea al primer `docker compose up` (montaje ./var/backup:/docker-entrypoint-initdb.d:ro).
MYSQL_USER=radius
MYSQL_DATABASE=radius
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_WAIT_INTERVAL=5

# === FreeRADIUS ===
# FREERADIUS_SQL_TLS: disabled (defecto) o require (exige TLS).
FREERADIUS_SQL_TLS=disabled
DEFAULT_CLIENT_SECRET=CHANGE_ME_DEFAULT_CLIENT_SECRET

# === Opcionales ===
TZ=Europe/Vienna
MYSQL_HEALTH_START_PERIOD=10m

# === LDAP (hook reservado, se ajusta tras despliegue base) ===
# Descomentar y rellenar cuando se defina el directorio LDAP.
# LDAP_HOST=
# LDAP_PORT=389
# LDAP_BASE_DN=
# LDAP_BIND_DN=
