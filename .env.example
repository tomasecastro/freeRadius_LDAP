# Copia este archivo a .env antes de ejecutar Docker Compose.
# Reemplaza cada valor CHANGE_ME por secretos propios del despliegue.
# No hay passwords reales en este ejemplo.

# === Conexion MySQL (sobreescribible) ===
MYSQL_HOST=radius-mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: puerto del host para MariaDB (por defecto 3306, igual que el interno).
# Cambiar (p. ej. 3307) para evitar conflictos con un MariaDB local.
# Las conexiones internas entre servicios usan siempre MYSQL_PORT (3306).
MYSQL_HOST_PORT=3306 # (sin efecto: radius-mysql no publica puertos; reservado)
# ./var/backup/ se crea al primer `docker compose up` (montaje ./var/backup:/docker-entrypoint-initdb.d:ro).
MYSQL_USER=radius
MYSQL_DATABASE=radius
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_WAIT_INTERVAL=5

# === FreeRADIUS ===
# FREERADIUS_SQL_TLS: disabled (defecto) o require (exige TLS).
FREERADIUS_SQL_TLS=disabled
DEFAULT_CLIENT_SECRET=CHANGE_ME_DEFAULT_CLIENT_SECRET

# === Opcionales ===
TZ=Europe/Vienna
MYSQL_HEALTH_START_PERIOD=10m

# === LDAP (directorio de identidad) ===
# Si LDAP_HOST se deja vacio el servidor arranca en modo base (solo SQL) y no
# toca nada de LDAP. Si se rellena, LDAP_BASE_DN / LDAP_BIND_DN / LDAP_BIND_PW
# son obligatorias: el contenedor falla al arrancar si falta alguna.
#
# Pasos en el servidor de identidad (ver documentacion del proveedor):
# 1. Crear el Provider LDAP y copiar su "Base DN" (parent DN) -> LDAP_BASE_DN.
# 2. Crear un usuario de servicio con permiso de lectura sobre el arbol y darle
#    una app password propia -> LDAP_BIND_DN y LDAP_BIND_PW.
# 3. Publicar el Outpost LDAP y apuntarlo a este host en el puerto 389
#    -> LDAP_HOST y LDAP_PORT.
# 4. Anadir a cada grupo LDAP un atributo custom "FreeRADIUSVLAN" con el VLAN
#    que corresponde. El post-auth lo lee para Tunnel-Private-Group-Id; si el
#    grupo no lo define se usa DEFAULT_VLAN.
#
# No hay secretos reales en este ejemplo: rellena con los valores de tu servidor.
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PW=
# Filtro de busqueda de usuarios. Por defecto busca por cn.
LDAP_USER_FILTER=(cn=%{User-Name})
# Grupos: base DN y filtro con los que rlm_ldap busca los grupos del usuario
# (bloque group {} de mods-available/ldap) y con los que el post-auth busca el
# atributo FreeRADIUSVLAN. Vacio = default del script: ou=groups,<LDAP_BASE_DN>
# y (objectClass=group).
# El Outpost LDAP de este despliegue publica los grupos bajo ou=groups con
# atributo member (DNs completos), asi que el filtro debe corresponder al
# objectClass que sirva ese directorio: ajustalos si tu directorio publica los
# grupos en otra rama o los tipa como posixGroup/groupOfUniqueNames.
LDAP_GROUP_BASE_DN=
LDAP_GROUP_FILTER=
# VLAN aplicado cuando el usuario autentica y su grupo no define FreeRADIUSVLAN.
DEFAULT_VLAN=20
